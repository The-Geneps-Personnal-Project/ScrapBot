# --- Discord ---
TOKEN=                      # Bot token
GUILD_ID=                   # Guild the slash commands are deployed to

# Channel IDs used in production (NODE_ENV=production)
UPDATE=                     # New-chapter notifications
ERROR=                      # Scraping failures
BACKUP=                     # Daily backup digest

# Channel IDs used in development
TEST_UPDATE=
TEST_ERROR=
TEST_BACKUP=

# --- Environment ---
NODE_ENV=development        # development | production

# --- ScrapAPI ---
# Selected by NODE_ENV: API_URL in production, API_TEST_URL otherwise.
# The bot fails fast with a clear message if the relevant one is missing.
API_URL=http://localhost:8080
API_TEST_URL=http://localhost:8080

# --- AniList ---
# Only needed to push read progress back to your list. The public metadata query
# is unauthenticated, so leaving this empty degrades gracefully.
ANILIST_TOKEN=

# --- Scraping ---
THREADS=4                   # Worker threads in the scraping pool

# Chromium used to parse JavaScript-rendered sites (/create site, /update site).
# On a Raspberry Pi: apt install chromium-browser, then point this at it.
# Leave empty to disable the fallback; such sites will then fail with a clear error.
PUPPETEER_EXECUTABLE_PATH=
